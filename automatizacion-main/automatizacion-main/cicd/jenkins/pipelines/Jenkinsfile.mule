y// =============================================================================
// Jenkinsfile.mule
// Pipeline CI/CD para aplicaciones Mule ESB / MuleSoft
//
// STAGES:
//   1. Checkout         - clonar código
//   2. Secret Scan      - detectar credenciales/secretos en el código
//   3. Build & Test     - compilar y tests MUnit
//   4. Security Scan    - OWASP check de dependencias
//   5. Package          - generar .jar deployable (Mule app)
//   6. Publish Nexus    - publicar versión en repositorio Mule de Nexus
//   7. Deploy (opcional)- desplegar en servidor Mule destino vía SSH/API
// =============================================================================

pipeline {
    agent any

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'qa', 'staging', 'production'],
            description: 'Ambiente de despliegue Mule'
        )
        booleanParam(
            name: 'DEPLOY_AFTER_BUILD',
            defaultValue: false,
            description: 'Desplegar automáticamente luego de compilar'
        )
        booleanParam(
            name: 'SKIP_TESTS',
            defaultValue: false,
            description: 'Saltar MUnit tests'
        )
        string(
            name: 'MULE_HOST',
            defaultValue: '',
            description: 'Host del servidor Mule destino (vacío = usar variable de ambiente)'
        )
    }

    environment {
        NEXUS_URL         = credentials('nexus-url')
        NEXUS_CREDENTIALS = credentials('nexus-credentials')
        MULE_CREDENTIALS  = credentials('mule-server-credentials')
        APP_NAME          = "${env.JOB_NAME.tokenize('/')[0]}"
        MAVEN_OPTS        = '-Xmx1024m'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '15', artifactNumToKeepStr: '3'))
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout()
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.APP_VERSION = sh(
                        script: "mvn help:evaluate -Dexpression=project.version -q -DforceStdout",
                        returnStdout: true
                    ).trim()
                    echo "App: ${env.APP_NAME} | Versión: ${env.APP_VERSION}"
                }
            }
        }

        // -----------------------------------------------------------------
        stage('Escaneo de Secretos') {
            steps {
                sh '''
                    echo "=== Verificando secretos en código Mule ==="
                    # Verificar que no haya credenciales hardcodeadas en XMLs Mule
                    if grep -rn --include="*.xml" --include="*.properties" \
                       -E "(password|username|api.key|client.secret)[[:space:]]*=[[:space:]]*[^$\{\}\[\]&]+" \
                       src/main/mule/ src/main/resources/ 2>/dev/null; then
                        echo "ADVERTENCIA: Posibles credenciales hardcodeadas detectadas."
                        echo "Usar Mule Secure Properties o variables de entorno."
                        exit 1
                    fi
                    echo "OK: Sin secretos detectados en código Mule."
                '''
            }
        }

        // -----------------------------------------------------------------
        stage('Build y MUnit Tests') {
            steps {
                script {
                    def skipTestsFlag = params.SKIP_TESTS ? '-DskipTests -DskipMunitTests' : ''
                    sh """
                        mvn clean verify \
                            ${skipTestsFlag} \
                            -Denvironment=${params.ENVIRONMENT} \
                            -B -q
                    """
                }
            }
            post {
                always {
                    junit testResults: '**/target/surefire-reports/*.xml',
                          allowEmptyResults: true
                }
            }
        }

        // -----------------------------------------------------------------
        stage('OWASP Dependency Check') {
            steps {
                sh '''
                    mvn org.owasp:dependency-check-maven:check \
                        -DfailBuildOnCVSS=7 \
                        -Dformat=HTML \
                        -B -q || true
                '''
            }
        }

        // -----------------------------------------------------------------
        stage('Package Mule App') {
            steps {
                sh """
                    mvn package -DskipTests=true \
                        -Dapp.runtime=4.4.0 \
                        -B -q
                """
                sh 'ls -lh target/*.jar 2>/dev/null || ls -lh target/*.zip 2>/dev/null || true'
            }
        }

        // -----------------------------------------------------------------
        stage('Publicar en Nexus') {
            steps {
                script {
                    def nexusRepo = env.APP_VERSION.endsWith('SNAPSHOT')
                        ? 'mule-snapshots' : 'mule-releases'

                    withCredentials([usernamePassword(
                        credentialsId: 'nexus-credentials',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )]) {
                        sh """
                            mvn deploy -DskipTests=true \
                                -DaltDeploymentRepository=nexus-mule::default::${NEXUS_URL}/repository/${nexusRepo}/ \
                                -B -q
                        """
                    }
                    echo "Mule app publicada en Nexus -> ${nexusRepo}"
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.jar,**/target/*.zip',
                                     fingerprint: true,
                                     allowEmptyArchive: true
                }
            }
        }

        // -----------------------------------------------------------------
        stage('Deploy a Mule Server') {
            when {
                expression { params.DEPLOY_AFTER_BUILD && params.ENVIRONMENT != 'production' }
            }
            steps {
                script {
                    def muleHost = params.MULE_HOST ?: env["MULE_HOST_${params.ENVIRONMENT.toUpperCase()}"]
                    def artifactFile = sh(
                        script: 'ls target/*.jar 2>/dev/null | head -1',
                        returnStdout: true
                    ).trim()

                    withCredentials([usernamePassword(
                        credentialsId: 'mule-server-credentials',
                        usernameVariable: 'MULE_USER',
                        passwordVariable: 'MULE_PASS'
                    )]) {
                        // Desplegar vía API REST de Mule Management Console o ARM
                        sh """
                            curl -f -u \${MULE_USER}:\${MULE_PASS} \
                                -X POST "http://${muleHost}:8080/mmc-console/api/repository" \
                                -F "name=${APP_NAME}" \
                                -F "version=${env.APP_VERSION}" \
                                -F "file=@${artifactFile}" || true
                        """
                    }
                }
            }
        }

        // -----------------------------------------------------------------
        stage('Approval Producción') {
            when {
                allOf {
                    expression { params.ENVIRONMENT == 'production' }
                    expression { params.DEPLOY_AFTER_BUILD }
                }
            }
            steps {
                timeout(time: 24, unit: 'HOURS') {
                    input(
                        message: "¿Confirmar deploy a PRODUCCIÓN de ${APP_NAME}:${env.APP_VERSION}?",
                        ok: 'Desplegar',
                        submitter: 'implementacion'
                    )
                }
            }
        }

    }

    post {
        success {
            echo "Build exitoso: ${APP_NAME}:${env.APP_VERSION}"
        }
        failure {
            echo "Build fallido: ${APP_NAME} en branch ${env.GIT_BRANCH}"
        }
        always {
            cleanWs(cleanWhenSuccess: true, cleanWhenFailure: false)
        }
    }
}
