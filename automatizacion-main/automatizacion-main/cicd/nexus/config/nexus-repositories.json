{
  "_comment": "Definición de repositorios Nexus para el ecosistema CI/CD.",
  "_version": "1.0",
  "repositories": [
    {
      "name": "maven-releases",
      "type": "hosted",
      "format": "maven2",
      "description": "Artefactos Java/Maven de versiones estables (no SNAPSHOT)",
      "policy": "RELEASE",
      "blobStore": "default",
      "strictContentTypeValidation": true
    },
    {
      "name": "maven-snapshots",
      "type": "hosted",
      "format": "maven2",
      "description": "Artefactos en desarrollo (SNAPSHOT)",
      "policy": "SNAPSHOT",
      "blobStore": "default",
      "strictContentTypeValidation": true
    },
    {
      "name": "maven-central-proxy",
      "type": "proxy",
      "format": "maven2",
      "description": "Proxy de Maven Central - caché local de dependencias externas",
      "remoteUrl": "https://repo1.maven.org/maven2/",
      "blobStore": "default",
      "strictContentTypeValidation": false,
      "negativeCache": true,
      "negativeCacheTTL": 1440
    },
    {
      "name": "mule-releases",
      "type": "hosted",
      "format": "maven2",
      "description": "Aplicaciones Mule ESB compiladas (versiones estables)",
      "policy": "RELEASE",
      "blobStore": "default",
      "strictContentTypeValidation": true
    },
    {
      "name": "mule-snapshots",
      "type": "hosted",
      "format": "maven2",
      "description": "Aplicaciones Mule ESB en desarrollo (SNAPSHOT)",
      "policy": "SNAPSHOT",
      "blobStore": "default",
      "strictContentTypeValidation": true
    },
    {
      "name": "mulesoft-proxy",
      "type": "proxy",
      "format": "maven2",
      "description": "Proxy repositorio MuleSoft EE",
      "remoteUrl": "https://repository.mulesoft.org/nexus/content/repositories/releases/",
      "blobStore": "default",
      "strictContentTypeValidation": false,
      "negativeCache": true,
      "negativeCacheTTL": 1440
    },
    {
      "name": "legacy-artifacts",
      "type": "hosted",
      "format": "raw",
      "description": "Repositorio para artefactos legacy sin estructura Maven (migración inicial desde laptops)",
      "blobStore": "default",
      "strictContentTypeValidation": false
    },
    {
      "name": "maven-public",
      "type": "group",
      "format": "maven2",
      "description": "Grupo público - única URL de resolución de dependencias para todos los proyectos",
      "members": [
        "maven-releases",
        "maven-snapshots",
        "maven-central-proxy",
        "mule-releases",
        "mule-snapshots",
        "mulesoft-proxy"
      ]
    }
  ]
}
