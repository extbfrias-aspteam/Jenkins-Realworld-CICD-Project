// ═══════════════════════════════════════════════════════════════════
// Jenkinsfile-java-maven-test
//
// Versión ADAPTADA del pipeline enterprise (Jenkinsfile-java-maven)
// para ejecutarse en el ambiente de contenedores de prueba.
//
// Qué se eliminó/stubeó vs el original:
//   ✗ @Library('shared-library')   → no existe en test env
//   ✗ agent { label 'maven-jdk17'} → cambiado a agent any
//   ✗ Vault (secretos)             → credenciales hardcodeadas de test
//   ✗ SonarQube                    → stage marcado como skip en test
//   ✗ WildFly/JBoss deployment     → reemplazado por SSH a target-servers
//   ✗ emailext                     → reemplazado por echo
//   ✗ config-repo clone            → no aplica en test
//   ✗ OWASP check                  → stubbed (requiere internet/NVD DB)
//
// Qué sí funciona end-to-end:
//   ✓ Build Maven real (java-app/)
//   ✓ Unit Tests con reporte JUnit
//   ✓ Package → JAR ejecutable
//   ✓ Upload a Nexus raw-test
//   ✓ Deploy SSH a target-server-1/2/3 según entorno
//   ✓ Verificación post-deploy
//   ✓ Access control (producción requiere confirmación)
// ═══════════════════════════════════════════════════════════════════

pipeline {
    agent any

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['qa', 'staging', 'production'],
            description: 'Entorno de despliegue'
        )
        booleanParam(
            name: 'SKIP_TESTS',
            defaultValue: false,
            description: 'Omitir tests unitarios'
        )
        booleanParam(
            name: 'DEPLOY_AFTER_BUILD',
            defaultValue: true,
            description: 'Desplegar en target-servers al terminar el build'
        )
    }

    environment {
        // Maven tool configurado en Jenkins (auto-instalado vía JCasC)
        MAVEN_HOME = tool 'Maven-3.9'
        PATH       = "${MAVEN_HOME}/bin:${env.PATH}"

        // Directorio del proyecto Maven dentro del repo
        APP_DIR    = 'java-app'

        // Nexus (disponible en la red test-network del compose)
        NEXUS_URL  = 'http://nexus:8081'
        NEXUS_REPO = 'raw-test'

        // SSH a target-servers
        SSH_CRED_ID  = 'ssh-deploy-key'
        DEPLOY_USER  = 'deploy'
        REMOTE_DIR   = '/opt/deploy'

        // Versión del build
        BUILD_VERSION = "${env.BUILD_NUMBER}"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10', artifactNumToKeepStr: '5'))
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        skipDefaultCheckout()
    }

    stages {

        // ── Stage 1: Initialize ──────────────────────────────────────
        stage('Initialize') {
            steps {
                checkout scm
                script {
                    echo "╔══════════════════════════════════════╗"
                    echo "║  Pipeline Java Maven - Test Env      ║"
                    echo "╚══════════════════════════════════════╝"
                    echo "Job         : ${env.JOB_NAME}"
                    echo "Build #     : ${env.BUILD_NUMBER}"
                    echo "Environment : ${params.ENVIRONMENT}"
                    echo "Skip Tests  : ${params.SKIP_TESTS}"
                    echo "Deploy      : ${params.DEPLOY_AFTER_BUILD}"
                }
                sh '''
                    echo "--- Toolchain ---"
                    java -version 2>&1
                    mvn  -version
                    echo "--- Workspace ---"
                    ls -la
                '''
            }
        }

        // ── Stage 2: Secret Scanning ─────────────────────────────────
        stage('Secret Scanning') {
            steps {
                script {
                    echo "=== Escaneo de secrets hardcodeados ==="
                    sh """
                        cd ${APP_DIR}
                        FOUND=0

                        # POSIX sh no soporta arrays — cada patrón se evalúa por separado.
                        # Se usa grep -E con clases POSIX ([[:space:]]) en lugar de \\s
                        # para compatibilidad con dash (shell por defecto en Jenkins).

                        RESULT=\$(grep -rEn 'password[[:space:]]*=[[:space:]]*"[^\$]' src/ 2>/dev/null | grep -v '//' || true)
                        if [ -n "\${RESULT}" ]; then
                            echo "[WARN] Posibles passwords hardcodeadas:"
                            echo "\${RESULT}"
                            FOUND=1
                        fi

                        RESULT=\$(grep -rEn 'api[._]key[[:space:]]*=' src/ 2>/dev/null | grep -v '//' || true)
                        if [ -n "\${RESULT}" ]; then
                            echo "[WARN] Posibles api_keys hardcodeadas:"
                            echo "\${RESULT}"
                            FOUND=1
                        fi

                        RESULT=\$(grep -rEn 'secret[[:space:]]*=[[:space:]]*"' src/ 2>/dev/null | grep -v '//' || true)
                        if [ -n "\${RESULT}" ]; then
                            echo "[WARN] Posibles secrets hardcodeados:"
                            echo "\${RESULT}"
                            FOUND=1
                        fi

                        if [ \$FOUND -eq 0 ]; then
                            echo "[OK] No se encontraron secrets hardcodeados"
                        fi
                    """
                }
            }
        }

        // ── Stage 3: Build ───────────────────────────────────────────
        stage('Build') {
            steps {
                script {
                    echo "=== Compilando proyecto Maven ==="
                    def skipFlag = params.SKIP_TESTS ? '-DskipTests' : ''
                    sh """
                        cd ${APP_DIR}
                        mvn clean compile ${skipFlag} \
                            -Denvironment=${params.ENVIRONMENT} \
                            -DbuildNumber=${BUILD_VERSION} \
                            --batch-mode
                    """
                }
            }
        }

        // ── Stage 4: Unit Tests ──────────────────────────────────────
        stage('Unit Tests') {
            when {
                expression { !params.SKIP_TESTS }
            }
            steps {
                sh """
                    cd ${APP_DIR}
                    mvn test \
                        -Denvironment=${params.ENVIRONMENT} \
                        --batch-mode
                """
            }
            post {
                always {
                    junit testResults: "${APP_DIR}/target/surefire-reports/*.xml",
                          allowEmptyResults: true
                }
            }
        }

        // ── Stage 5: SonarQube (stub en test env) ────────────────────
        stage('SonarQube Analysis') {
            steps {
                echo "=== [STUB] SonarQube no disponible en test env ==="
                echo "En producción: mvn sonar:sonar -Dsonar.host.url=\$SONARQUBE_URL"
                echo "Instalar plugin SonarQube Scanner para habilitar este stage."
            }
        }

        // ── Stage 6: Security Scan (stub en test env) ────────────────
        stage('Security Scan - OWASP') {
            steps {
                echo "=== [STUB] OWASP Dependency Check no configurado en test env ==="
                echo "En producción: mvn org.owasp:dependency-check-maven:check"
            }
        }

        // ── Stage 7: Package ─────────────────────────────────────────
        stage('Package') {
            steps {
                sh """
                    cd ${APP_DIR}
                    mvn package -DskipTests \
                        -Denvironment=${params.ENVIRONMENT} \
                        -DbuildNumber=${BUILD_VERSION} \
                        --batch-mode
                """
                archiveArtifacts artifacts: "${APP_DIR}/target/*.jar",
                                  fingerprint: true
                script {
                    def jar = sh(
                        script: "ls ${APP_DIR}/target/*.jar | head -1",
                        returnStdout: true
                    ).trim()
                    echo "Artefacto generado: ${jar}"
                }
            }
        }

        // ── Stage 8: Upload to Nexus ─────────────────────────────────
        stage('Upload to Nexus') {
            steps {
                script {
                    echo "=== Subiendo artefacto a Nexus [${NEXUS_URL}/repository/${NEXUS_REPO}] ==="
                    def jar = sh(
                        script: "ls ${APP_DIR}/target/*.jar | head -1",
                        returnStdout: true
                    ).trim()
                    def filename = jar.tokenize('/').last()

                    sh """
                        HTTP_CODE=\$(curl -s -o /tmp/nexus-upload.log -w '%{http_code}' \
                            -u admin:nexus123 \
                            --upload-file ${jar} \
                            '${NEXUS_URL}/repository/${NEXUS_REPO}/${params.ENVIRONMENT}/${filename}')

                        echo "Nexus HTTP: \${HTTP_CODE}"
                        cat /tmp/nexus-upload.log || true

                        if echo "\${HTTP_CODE}" | grep -qE '^(200|201|204)\$'; then
                            echo "[OK] Upload exitoso"
                            echo "URL: ${NEXUS_URL}/repository/${NEXUS_REPO}/${params.ENVIRONMENT}/${filename}"
                        else
                            echo "[WARN] Upload a Nexus devolvió HTTP \${HTTP_CODE} - continuando"
                        fi
                    """
                }
            }
        }

        // ── Stage 9: Deploy ──────────────────────────────────────────
        stage('Deploy to Servers') {
            when {
                expression { params.DEPLOY_AFTER_BUILD }
            }
            steps {
                script {
                    echo "=== Desplegando en ambiente: ${params.ENVIRONMENT} ==="
                    def jar = sh(
                        script: "ls ${APP_DIR}/target/*.jar | head -1",
                        returnStdout: true
                    ).trim()
                    def filename = jar.tokenize('/').last()

                    // qa → solo server-1 | staging/production → los 3 servers
                    def servers = ['target-server-1']
                    if (params.ENVIRONMENT in ['staging', 'production']) {
                        servers = ['target-server-1', 'target-server-2', 'target-server-3']
                    }

                    sshagent(credentials: [SSH_CRED_ID]) {
                        for (server in servers) {
                            sh """
                                echo "── Desplegando en ${server} ──"
                                ssh -o StrictHostKeyChecking=no \
                                    ${DEPLOY_USER}@${server} \
                                    "mkdir -p ${REMOTE_DIR}/${params.ENVIRONMENT}"

                                scp -o StrictHostKeyChecking=no \
                                    ${jar} \
                                    ${DEPLOY_USER}@${server}:${REMOTE_DIR}/${params.ENVIRONMENT}/${filename}

                                ssh -o StrictHostKeyChecking=no \
                                    ${DEPLOY_USER}@${server} \
                                    "ls -lh ${REMOTE_DIR}/${params.ENVIRONMENT}/${filename}"

                                echo "[OK] Desplegado en ${server}:${REMOTE_DIR}/${params.ENVIRONMENT}/${filename}"
                            """
                        }
                    }
                }
            }
        }

        // ── Stage 10: Post-Deployment Verification ───────────────────
        stage('Post-Deployment Verification') {
            when {
                expression { params.DEPLOY_AFTER_BUILD }
            }
            steps {
                script {
                    echo "=== Verificando despliegue en ${params.ENVIRONMENT} ==="
                    def jar = sh(
                        script: "ls ${APP_DIR}/target/*.jar | head -1",
                        returnStdout: true
                    ).trim()
                    def filename = jar.tokenize('/').last()

                    def servers = ['target-server-1']
                    if (params.ENVIRONMENT in ['staging', 'production']) {
                        servers = ['target-server-1', 'target-server-2', 'target-server-3']
                    }

                    sshagent(credentials: [SSH_CRED_ID]) {
                        sh """
                            echo ""
                            echo "╔══════════════════════════════════════════╗"
                            echo "║        RESULTADO DE DESPLIEGUE           ║"
                            echo "╚══════════════════════════════════════════╝"
                        """
                        for (server in servers) {
                            sh """
                                echo "── ${server} ──────────────────────"
                                ssh -o StrictHostKeyChecking=no \
                                    ${DEPLOY_USER}@${server} \
                                    "test -f ${REMOTE_DIR}/${params.ENVIRONMENT}/${filename} && \
                                     ls -lh ${REMOTE_DIR}/${params.ENVIRONMENT}/${filename} && \
                                     echo 'STATUS: DEPLOYED OK'" || \
                                echo 'STATUS: ERROR - archivo no encontrado'
                            """
                        }
                    }
                }
            }
        }

        // ── Stage 11: Production Approval ────────────────────────────
        stage('Production Approval') {
            when {
                allOf {
                    expression { params.ENVIRONMENT == 'production' }
                    expression { !params.DEPLOY_AFTER_BUILD }
                }
            }
            steps {
                script {
                    echo "=== Esperando aprobación para despliegue en PRODUCCIÓN ==="
                    timeout(time: 24, unit: 'HOURS') {
                        input(
                            message: '¿Desplegar en PRODUCCIÓN?',
                            ok: 'Desplegar',
                            submitter: 'admin',
                            submitterParameter: 'APPROVER'
                        )
                    }
                    echo "Aprobado por: ${env.APPROVER}"
                }
            }
        }
    }

    post {
        always {
            // cleanWs() requiere el plugin 'ws-cleanup' (no instalado en test env).
            // deleteDir() es equivalente y está incluido en workflow-basic-steps.
            deleteDir()
        }
        success {
            echo """
╔══════════════════════════════════════════════════════╗
║  PIPELINE EXITOSO                                    ║
║  Build #${env.BUILD_NUMBER} - ${params.ENVIRONMENT.toUpperCase()}
╚══════════════════════════════════════════════════════╝
            """
        }
        failure {
            echo """
╔══════════════════════════════════════════════════════╗
║  PIPELINE FALLIDO                                    ║
║  Build #${env.BUILD_NUMBER} - Revisar logs           ║
╚══════════════════════════════════════════════════════╝
            """
        }
    }
}
