FROM jenkins/jenkins:lts-jdk17

# ─────────────────────────────────────────────────────────────────
# Dockerfile.jenkins — Jenkins con plugins pre-instalados en build
# time para evitar fallos por descarga tardía de plugins en runtime.
# ─────────────────────────────────────────────────────────────────

USER root

# openssh-client: requerido por el step sshagent() y scp/ssh en pipelines
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        openssh-client \
        curl \
    && rm -rf /var/lib/apt/lists/*

USER jenkins

# Pre-instalar todos los plugins al momento de buildear la imagen.
# jenkins-plugin-cli viene incluido en jenkins/jenkins:lts-jdk17.
# Con esto, JCasC y ssh-agent están disponibles desde el primer arranque.
COPY jenkins-config/plugins.txt /usr/share/jenkins/ref/plugins.txt
RUN jenkins-plugin-cli \
        --plugin-file /usr/share/jenkins/ref/plugins.txt \
        --verbose
