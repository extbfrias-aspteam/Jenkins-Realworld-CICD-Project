# ─────────────────────────────────────────
# Variables del Ambiente de Prueba
# ─────────────────────────────────────────

# Jenkins
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=admin123

# Nexus
NEXUS_ADMIN_PASSWORD=nexus123

# SSH - usuario en servers destino
SSH_DEPLOY_USER=deploy

# Nombres de los servers destino (deben coincidir con los aliases de docker-compose)
TARGET_SERVER_1=target-server-1
TARGET_SERVER_2=target-server-2
TARGET_SERVER_3=target-server-3

# ─────────────────────────────────────────
# GitHub (para el job 'maven' - Pipeline SCM)
# ─────────────────────────────────────────
# Usuario Git para clonar el repositorio (por defecto: git)
GITHUB_USER=git
# Token de acceso personal GitHub - SOLO necesario si el repo es PRIVADO.
# Crear en: https://github.com/settings/tokens/new  (scope mínimo: repo)
# Opción 1: exportar en la shell antes de ejecutar start-test-env.sh
#   export GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# Opción 2: descomentar y pegar el token aquí (NO commitear este archivo)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
