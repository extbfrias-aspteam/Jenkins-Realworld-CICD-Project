<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
	http://www.springframework.org/schema/beans/spring-beans-2.5.xsd">
	
	<bean id="insertarParametroPStd" class="java.lang.String">
		<constructor-arg type="java.lang.String"
			value="INSERT INTO BLU.BLPARAMETROS( CLAVE, VALOR, FECHA, ESTADO, USUARIO_CREACION, FECHA_CREACION )
			       VALUES (?, ?, CURRENT_DATE, ?, ?, CURRENT_TIMESTAMP)"/>
	</bean>
	
	<bean id="actualizarParametroPStd" class="java.lang.String">
		<constructor-arg type="java.lang.String"
			value="UPDATE BLU.BLPARAMETROS SET
			       ESTADO = ?, 
			       USUARIO_MODIFICACION = ?,
			       FECHA_MODIFICACION = CURRENT_TIMESTAMP
			       WHERE CLAVE = ?
			       AND ESTADO = 'A'"/>
	</bean>
	
	<bean id="ParametroPStd" class="java.lang.String">
		<constructor-arg type="java.lang.String"
			value="SELECT
			       CLAVE,
			       VALOR,
				   TO_CHAR(FECHA, 'YYYY/MM/DD') AS FECHA, 
				   ESTADO
			       FROM BLU.BLPARAMETROS
			       WHERE CLAVE = ? 
			       AND ESTADO = 'A'
			       ORDER BY FECHA_CREACION DESC
			       LIMIT 1"/>
	</bean>
	
	<bean id="ParametrosStdDAO" class="net.std.dao.ParametrosStdDAO">
		<property name="jdbcTemplateSti" ref="jdbcTemplateSti"/>
		<property name="insertarParametroPStd" ref="insertarParametroPStd"/>
		<property name="actualizarParametroPStd" ref="actualizarParametroPStd"/>
		<property name="ParametroPStd" ref="ParametroPStd"/>
	</bean>
	
</beans>