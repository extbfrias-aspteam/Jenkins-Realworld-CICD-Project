<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
	http://www.springframework.org/schema/beans/spring-beans-2.5.xsd">
	
	<bean id="getEstatusID" class="java.lang.String">
		<constructor-arg type="java.lang.String"
			value="SELECT ID, DESCRIPCION FROM NUCLEOCENTRAL.NCESTATUS WHERE DESCRIPCION = ? LIMIT 1"/>            
	</bean>
	
	<bean id="getMonedaID" class="java.lang.String">
		<constructor-arg type="java.lang.String"
			value="SELECT ID, MONEDA FROM NUCLEOCENTRAL.NCMONEDA WHERE MONEDA = ? LIMIT 1"/>            
	</bean>
	
	<bean id="getTipoAhorroID" class="java.lang.String">
		<constructor-arg type="java.lang.String"
			value="SELECT ID, CLAVE, DESCRIPCION FROM PRODUCTOS.PRTIPOS_PRODUCTOS_AHORRO WHERE CLAVE = ? LIMIT 1"/>            
	</bean>
	
	<bean id="getClaveCnbvID" class="java.lang.String">
		<constructor-arg type="java.lang.String"
			value="SELECT 0 AS ID LIMIT 1"/>            
	</bean>
	
	<bean id="getComoEnteroID" class="java.lang.String">
		<constructor-arg type="java.lang.String"
			value="SELECT ID, COMOSEENTERO, ID_ESTATUS
					FROM NUCLEOCENTRAL.NCCOMO_ENTERO 
					WHERE COMOSEENTERO = ? LIMIT 1"/>            
	</bean>
	
	
	<bean id="CatalogosProdAhorroCeroStdDAO" class="net.std.productos.dao.CatalogosProdAhorroCeroStdDAO">
		<property name="jdbcTemplate" ref="jdbcTemplate"/>
		<property name="getEstatusID" ref="getEstatusID"/>
		<property name="getMonedaID" ref="getMonedaID"/>
		<property name="getTipoAhorroID" ref="getTipoAhorroID"/>
		<property name="getClaveCnbvID" ref="getClaveCnbvID"/>
		<property name="getComoEnteroID" ref="getComoEnteroID"/>
	</bean>
	
</beans>