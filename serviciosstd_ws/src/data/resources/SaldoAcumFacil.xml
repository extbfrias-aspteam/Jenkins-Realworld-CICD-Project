<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
	http://www.springframework.org/schema/beans/spring-beans-2.5.xsd">
	
	<bean id="leerTransaccionAcumulable" class="java.lang.String">
		<constructor-arg type="java.lang.String"
			value="
				select COALESCE(at2.acumulable,false) as acumulable from ahorro.ahtipos_transacciones at2
				 where at2.clave_trans_dock = ?
			"/>
	</bean>
	
	<bean id="obtenerAcumuladoMensual" class="java.lang.String">
		<constructor-arg type="java.lang.String"
			value="SELECT am.saldo_acumulado FROM ahorro.ahacumulado_mensual_cuentas am
  					WHERE am.cuenta = ? and am.anio = ? and am.mes = ? LIMIT 1"/>
	</bean>
	<bean id="obtenerValorUdis" class="java.lang.String">
		<constructor-arg type="java.lang.String"
						 value="SELECT i.* FROM interes i JOIN  tasas t on I.tasa = t.clave
  								where anio=? and t.tasa_prod = 'UDI'"/>
	</bean>
	<bean id="obtenerParametroUdi" class="java.lang.String">
		<constructor-arg type="java.lang.String"
						 value="SELECT CAST(COALESCE(valor,'0') AS INTEGER) as total
						 			FROM parametros_generales p WHERE p.clave = 'SEG_MTO_MAX_AHO_SIMP'"/>
	</bean>
	
	<bean id="AcumuladoSaldoMensualDAO" class="net.std.dao.AcumuladoSaldoMensualDAO">
		<property name="jdbcTemplatePr" ref="jdbcTemplatePr"/>
		<property name="jdbcTemplate" ref="jdbcTemplate"/>
		<property name="leerTransaccionAcumulable" ref="leerTransaccionAcumulable"/>
		<property name="obtenerAcumuladoMensual" ref="obtenerAcumuladoMensual"/>
		<property name="obtenerValorUdis" ref="obtenerValorUdis"/>
		<property name="obtenerParametroUdi" ref="obtenerParametroUdi"/>
	</bean>
	
</beans>