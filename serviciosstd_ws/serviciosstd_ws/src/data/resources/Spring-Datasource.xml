<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
	xmlns:jee="http://www.springframework.org/schema/jee"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-2.5.xsd
						http://www.springframework.org/schema/util http://www.springframework.org/schema/util/spring-util-2.0.xsd
						http://www.springframework.org/schema/jee http://www.springframework.org/schema/jee/spring-jee-2.0.xsd">

	<jee:jndi-lookup id="ds" jndi-name="java:jboss/datasources/PgCeroDS"/>
	<jee:jndi-lookup id="dsPr" jndi-name="java:jboss/datasources/ProcreaDS"/>
	<jee:jndi-lookup id="dsSti" jndi-name="java:jboss/datasources/IzelStiDS"/>
	
	<bean id="jdbcTemplate" class="org.springframework.jdbc.core.JdbcTemplate">
		<property name="dataSource" ref="ds" />
	</bean>
	
	<bean id="jdbcTemplatePr" class="org.springframework.jdbc.core.JdbcTemplate">
		<property name="dataSource" ref="dsPr" />
	</bean>
	
	<bean id="jdbcTemplateSti" class="org.springframework.jdbc.core.JdbcTemplate">
		<property name="dataSource" ref="dsSti" />
	</bean>
		
	<bean id="namedJdbcTemplate" class="org.springframework.jdbc.core.namedparam.NamedParameterJdbcTemplate">
		<constructor-arg ref="ds"/>
	</bean>
	<bean id="namedJdbcTemplatePr" class="org.springframework.jdbc.core.namedparam.NamedParameterJdbcTemplate">
		<constructor-arg ref="dsPr"/>
	</bean>
  	
</beans>